<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌸 Cómo se Juega 🌸"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#D96B93"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guía rápida del taller de moda real"
            android:textSize="13sp"
            android:textColor="#8C5C6F"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- Diagrama Visual del Vestidor (Tonos Pastel) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FCEBF1"
            app:strokeColor="#FAD2E1"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <!-- Menú Lateral Izquierdo Simulado -->
                <LinearLayout
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👠 Zapatillas"
                        android:textSize="11sp"
                        android:textColor="#5E3A47"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👗 Vestido"
                        android:textSize="11sp"
                        android:textColor="#5E3A47"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👒 Sombrero"
                        android:textSize="11sp"
                        android:textColor="#5E3A47"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ Aretes"
                        android:textSize="11sp"
                        android:textColor="#5E3A47"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💇‍♀️ Pelo"
                        android:textSize="11sp"
                        android:textColor="#5E3A47" />
                </LinearLayout>

                <!-- Centro: Modelo + Barra Inferior -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="10dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="96dp"
                        android:contentDescription="Modelo central"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu Personaje"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#D96B93"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:text="Barra Inferior: Opciones de Prendas"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#5E3A47"
                        android:background="#FAD2E1"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Paso 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#5E3A47"
                    android:background="#FAD2E1"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escoge a tu Modelo"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#5E3A47" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca PLAY en la pantalla principal y selecciona a tu personaje favorita para comenzar a vestirla."
                        android:textSize="12sp"
                        android:textColor="#8C5C6F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Paso 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#5E3A47"
                    android:background="#E8DFF5"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona Categorías y Prendas"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#5E3A47" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usa los botones laterales (Zapatillas, Vestido, Sombrero, Aretes, Pelo) y toca las opciones de abajo para probárselas."
                        android:textSize="12sp"
                        android:textColor="#8C5C6F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Paso 3 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="3"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#5E3A47"
                    android:background="#FCE1E4"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Juego Libre y Galería"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#5E3A47" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No hay niveles ni límites de tiempo. Combina libremente y guarda tus mejores diseños en la Galería."
                        android:textSize="12sp"
                        android:textColor="#8C5C6F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Volver -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_volver_como_jugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="¡ENTENDIDO!"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#E884A7"
            app:cornerRadius="26dp" />

    </LinearLayout>
</ScrollView>