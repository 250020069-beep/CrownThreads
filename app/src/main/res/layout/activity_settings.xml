<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌸 Ajustes del Palacio 🌸"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#D96B93"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Sección Perfiles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil de Personaje Predeterminado"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#5E3A47"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Flecha Izquierda (48x48dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scroll_left"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="◀"
                android:textSize="14sp"
                android:textColor="#5E3A47"
                app:backgroundTint="#F7D6E0"
                app:cornerRadius="24dp"
                android:layout_marginEnd="6dp" />

            <!-- Carrusel de 4 Perfiles -->
            <HorizontalScrollView
                android:id="@+id/horizontal_scroll_characters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Perfil 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_character_1"
                        android:layout_width="95dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FAD2E1"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/img_char_1"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:contentDescription="Personaje 1"
                                android:src="@android:drawable/ic_menu_gallery" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modelo 1"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#5E3A47"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Perfil 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_character_2"
                        android:layout_width="95dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/img_char_2"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:contentDescription="Personaje 2"
                                android:src="@android:drawable/ic_menu_gallery" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modelo 2"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#5E3A47"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Perfil 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_character_3"
                        android:layout_width="95dp"
                        android:layout_height="125dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/img_char_3"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:contentDescription="Personaje 3"
                                android:src="@android:drawable/ic_menu_gallery" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modelo 3"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#5E3A47"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Perfil 4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_character_4"
                        android:layout_width="95dp"
                        android:layout_height="125dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/img_char_4"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:contentDescription="Personaje 4"
                                android:src="@android:drawable/ic_menu_gallery" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modelo 4"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#5E3A47"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Flecha Derecha (48x48dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scroll_right"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="▶"
                android:textSize="14sp"
                android:textColor="#5E3A47"
                app:backgroundTint="#F7D6E0"
                app:cornerRadius="24dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- ESPACIO RESERVADO EN BLANCO PARA DISEÑO DE PERSONAJE (C++ / OPENGL) -->
        <FrameLayout
            android:id="@+id/container_character_design_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Opciones del Juego -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_save_outfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar outfit automáticamente"
            android:textColor="#5E3A47"
            android:checked="true"
            app:thumbTint="#F2A6C0"
            app:trackTint="#FAD2E1"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_sparkle_effects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Efectos brillantes de costura"
            android:textColor="#5E3A47"
            android:checked="true"
            app:thumbTint="#F2A6C0"
            app:trackTint="#FAD2E1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Música de Fondo"
            android:textColor="#5E3A47"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seekbar_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="75"
            android:progressTint="#F2A6C0"
            android:thumbTint="#D96B93"
            android:layout_marginBottom="24dp" />

        <!-- Botón Guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="GUARDAR CAMBIOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#E884A7"
            app:cornerRadius="26dp" />

    </LinearLayout>
</ScrollView>